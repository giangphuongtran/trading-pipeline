# -----------------------------------------------------------------------------
# Trading Pipeline - Environment Variables
# Copy this file to `.env` and fill in secrets/credentials.
# -----------------------------------------------------------------------------

# --- Polygon ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Postgres (Docker Compose service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_data

# Port that Postgres is exposed on your host machine (left side of ports mapping)
POSTGRES_PORT_HOST=5441

# Optional: explicit URLs (recommended)
# Local machine connecting to docker-published Postgres:
DATABASE_URL_HOST=postgresql://postgres:postgres@localhost:5441/trading_data
# Inside Docker network (Airflow tasks):
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/trading_data

# Airflow database URL (Airflow metadata DB). We re-use the same Postgres instance.
AIRFLOW_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/trading_data

# --- Airflow UI / Admin user ---
AIRFLOW_PORT_HOST=8083
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_FIRSTNAME=Airflow
AIRFLOW_LASTNAME=Admin
AIRFLOW_EMAIL=airflow@example.com

# Generated by `./project_setup.sh` (it will overwrite this value)
AIRFLOW_FERNET_KEY=

# --- Pipeline flags ---
# Enable Pandera validation gates during ingestion/backfills (0/1)
ENABLE_DATA_QUALITY_CHECKS=0
# Optional: "json" for JSON logs, anything else for plain text.
LOG_FORMAT=plain


